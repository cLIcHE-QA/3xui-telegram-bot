BOT_TOKEN=123456:replace_me

PANEL_URL=https://panel.example.com
PANEL_API_TOKEN=replace_me

SUBSCRIPTION_URL_TEMPLATE=https://sub.example.com/sub/{sub_id}

ALLOWED_TELEGRAM_IDS=123456789

# Exact ports from your current node.
# The bot will only consider these user-facing inbounds.
ALLOWED_PORTS=2053,2083,443

# Optional extra restriction by protocol.
ALLOWED_PROTOCOLS=vless,hysteria

# Optional exact numeric inbound IDs from 3x-ui.
# Leave empty for the first test. Run /inbounds, inspect IDs, then pin them here.
INBOUND_IDS=

# Automatically ignore technical/service inbounds.
IGNORED_TAGS=api
IGNORED_PROTOCOLS=tunnel

TEST_DAYS=7
TEST_TRAFFIC_GB=10
TEST_IP_LIMIT=2

DB_PATH=bot.sqlite3
VERIFY_TLS=true
