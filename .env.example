BOT_TOKEN=123456:replace_me

PANEL_URL=https://panel.example.com/basepath
PANEL_API_TOKEN=replace_me

# Existing/raw 3x-ui subscription URL. The compatibility proxy fetches this.
SUBSCRIPTION_URL_TEMPLATE=https://sub.example.com:2096/sub/{sub_id}

# Public URL that the Telegram bot sends to users.
# Point /compat/ at the bot's local HTTP proxy (see README).
# Leave empty to keep sending the original 3x-ui URL.
COMPAT_SUBSCRIPTION_URL_TEMPLATE=https://sub.example.com/compat/{sub_id}
SUBSCRIPTION_PROXY_HOST=0.0.0.0
SUBSCRIPTION_PROXY_PORT=8080

ALLOWED_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_IDS=123456789

ALLOWED_PORTS=2053,2083,443,51820
ALLOWED_PROTOCOLS=vless,hysteria,amneziawg
INBOUND_IDS=
IGNORED_TAGS=api
IGNORED_PROTOCOLS=tunnel

TEST_DAYS=7
TEST_TRAFFIC_GB=10
TEST_IP_LIMIT=2

# XTLS flow for VLESS clients. Empty value disables automatic flow changes.
VLESS_FLOW=xtls-rprx-vision

DB_PATH=bot.sqlite3
VERIFY_TLS=true

# Backups
BACKUP_ENABLED=true
BACKUP_DIR=/app/data/backups
BACKUP_KEEP=14
# Daily automatic backup time, UTC hour 0..23.
BACKUP_HOUR_UTC=2
# If true, the full archive is also sent to every ADMIN_TELEGRAM_IDS chat.
# Full archives contain secrets, so this is disabled by default.
BACKUP_SEND_TO_ADMINS=false

# Host paths used only by docker-compose bind mounts for full backups.
# 3x-ui SQLite defaults to /etc/x-ui/x-ui.db, so mount its whole directory
# to allow SQLite to see possible WAL/SHM files during a consistent backup.
BACKUP_XUI_DIR_HOST_PATH=/etc/x-ui
BACKUP_NGINX_CONF_HOST_PATH=/opt/mtproxyl-nginx/conf


# Master card shown in /admin -> Nodes / System status
MASTER_NAME=Master
MASTER_FLAG=🇳🇱

# v3.7 optional direct database backups for native 3x-ui nodes.
# Health/status does NOT need these: nodes are discovered from the master panel.
# A dedicated admin-scope token is required for GET /panel/api/server/getDb.
# Keep empty until the Finland node is registered and ready.
NODE_BACKUP_TARGETS=
# Example:
# NODE_BACKUP_TARGETS=FI
# NODE_BACKUP_FI_NODE_NAME=Finland
# NODE_BACKUP_FI_PANEL_URL=https://fi-panel.example.com/basepath
# NODE_BACKUP_FI_API_TOKEN=replace_with_dedicated_admin_scope_token
# NODE_BACKUP_FI_VERIFY_TLS=true
