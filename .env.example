# Telegram
BOT_TOKEN=123456:replace_me

# 3x-ui panel root URL. Do not add /panel/api here.
PANEL_URL=https://panel.example.com
PANEL_API_TOKEN=replace_me

# Your already-enabled subscription page.
# {sub_id} will be replaced by the client's subId.
SUBSCRIPTION_URL_TEMPLATE=https://sub.example.com/sub/{sub_id}

# During tests the bot will ONLY work for these Telegram numeric IDs.
# Comma-separated. Do not leave empty on an Internet-facing bot.
ALLOWED_TELEGRAM_IDS=123456789

# Optional fixed inbound IDs.
# Empty = take all enabled inbounds whose protocol is in ALLOWED_PROTOCOLS.
INBOUND_IDS=
ALLOWED_PROTOCOLS=vless,vmess,trojan,shadowsocks,hysteria,mtproto

# Test access parameters
TEST_DAYS=7
TEST_TRAFFIC_GB=10
TEST_IP_LIMIT=2

# Local DB
DB_PATH=bot.sqlite3

# TLS verification. Keep true unless you deliberately use a self-signed cert.
VERIFY_TLS=true
