BOT_TOKEN=123456:replace_me

PANEL_URL=https://panel.example.com/basepath
PANEL_API_TOKEN=replace_me

# Existing/raw 3x-ui subscription URL. The compatibility proxy fetches this.
SUBSCRIPTION_URL_TEMPLATE=https://sub.example.com:2096/sub/{sub_id}

# Public URL that the Telegram bot sends to users.
# Point /compat/ at the bot's local HTTP proxy (see README).
# Leave empty to keep sending the original 3x-ui URL.
COMPAT_SUBSCRIPTION_URL_TEMPLATE=https://sub.example.com/compat/{sub_id}
SUBSCRIPTION_PROXY_HOST=0.0.0.0
SUBSCRIPTION_PROXY_PORT=8080

ALLOWED_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_IDS=123456789

ALLOWED_PORTS=2053,2083,443,51820
ALLOWED_PROTOCOLS=vless,hysteria,amneziawg
INBOUND_IDS=
IGNORED_TAGS=api
IGNORED_PROTOCOLS=tunnel

TEST_DAYS=7
TEST_TRAFFIC_GB=10
TEST_IP_LIMIT=2

# XTLS flow for VLESS clients. Empty value disables automatic flow changes.
VLESS_FLOW=xtls-rprx-vision

DB_PATH=bot.sqlite3
VERIFY_TLS=true

# Backups
BACKUP_ENABLED=true
BACKUP_DIR=/app/data/backups
BACKUP_KEEP=14
# Daily automatic backup time, UTC hour 0..23.
BACKUP_HOUR_UTC=2
# If true, the full archive is also sent to every ADMIN_TELEGRAM_IDS chat.
# Full archives contain secrets, so this is disabled by default.
BACKUP_SEND_TO_ADMINS=false

# Optional encrypted off-site Full Backup replication.
# Disabled by default. When enabled, the bot uploads only canonical verified
# 3xui-bot-backup-*.tar.gz archives to the fixed bucket/prefix below.
# The archive is encrypted client-side with AES-256-GCM before upload.
OFFSITE_BACKUP_ENABLED=false
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_PREFIX=3xui-bot
OFFSITE_BACKUP_REGION=us-east-1
# Leave empty for AWS S3. Custom S3-compatible endpoints MUST use verified HTTPS.
OFFSITE_BACKUP_ENDPOINT_URL=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
OFFSITE_BACKUP_KEEP=14
# Base64 of exactly 32 random bytes. Keep a recovery copy outside the Master VPS.
OFFSITE_BACKUP_ENCRYPTION_KEY_B64=

# Optional v4.19+ restricted local Deploy Agent for Owner-only bot self-update.
# Leave BOTH values empty until the host-side agent is installed.
# URL must be private/local plain HTTP; the agent listener is not exposed publicly.
# The token is generated by scripts/install-deploy-agent.sh and must be copied
# locally from /etc/3xui-deploy-agent/token. Never send it through Telegram/chat.
DEPLOY_AGENT_URL=
DEPLOY_AGENT_TOKEN=

# Host paths used only by docker-compose bind mounts for full backups.
# 3x-ui SQLite defaults to /etc/x-ui/x-ui.db, so mount its whole directory
# to allow SQLite to see possible WAL/SHM files during a consistent backup.
BACKUP_XUI_DIR_HOST_PATH=/etc/x-ui
BACKUP_NGINX_CONF_HOST_PATH=/opt/mtproxyl-nginx/conf

# Optional read-only source for /admin -> Monitoring -> Logs.
NGINX_LOG_HOST_PATH=/var/log/nginx


# Master card shown in /admin -> Nodes / System status
MASTER_NAME=Master
MASTER_FLAG=🇳🇱

# v4.10+ optional restricted host-control targets.
# v4.11 prefers *_NODE_ID for direct nodes; NAME remains display/fallback compatibility.
# Remote targets MUST use verified HTTPS. Plain HTTP is accepted only for
# HOST_CONTROL_MASTER_URL on a private/local address (for example a Docker-host route).
# Use a dedicated random token per host; never reuse PANEL_API_TOKEN or node tokens.
HOST_CONTROL_TARGETS=
# Example:
# HOST_CONTROL_TARGETS=MASTER,FI
# HOST_CONTROL_MASTER_NAME=Master
# HOST_CONTROL_MASTER_HOST_ID=master
# HOST_CONTROL_MASTER_URL=http://172.19.0.1:18182
# HOST_CONTROL_MASTER_TOKEN=replace_with_dedicated_32_byte_random_token
# HOST_CONTROL_MASTER_VERIFY_TLS=true
# HOST_CONTROL_FI_NAME=Finland
# HOST_CONTROL_FI_NODE_ID=2
# HOST_CONTROL_FI_HOST_ID=fi
# HOST_CONTROL_FI_URL=https://fi-host-control.example.com
# HOST_CONTROL_FI_TOKEN=replace_with_another_dedicated_32_byte_random_token
# HOST_CONTROL_FI_VERIFY_TLS=true

# v3.7+ optional direct admin connections for native 3x-ui nodes.
# v4.11 prefers *_NODE_ID for stable binding across node rename.
# Health/status does NOT need these: nodes are discovered from the master panel.
# A dedicated admin-scope token is required for GET /panel/api/server/getDb.
# v4.4 also reuses this direct token for the optional remote Xray restart action.
# v4.7 reuses it for guarded per-node database restore after creating a rescue backup.
# Keep empty until the Finland node is registered and ready.
NODE_BACKUP_TARGETS=
# Example:
# NODE_BACKUP_TARGETS=FI
# NODE_BACKUP_FI_NODE_NAME=Finland
# NODE_BACKUP_FI_NODE_ID=2
# NODE_BACKUP_FI_PANEL_URL=https://fi-panel.example.com/basepath
# NODE_BACKUP_FI_API_TOKEN=replace_with_dedicated_admin_scope_token
# NODE_BACKUP_FI_VERIFY_TLS=true


# Stable Docker subnet for the bot Compose project. Keep the UFW rule for 3x-ui
# port 2096 in sync with this subnet when the panel is reached through the host's
# public address.
BOT_DOCKER_SUBNET=172.19.0.0/16
