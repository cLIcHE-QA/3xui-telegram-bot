# #887 D1b. ШАБЛОН, НЕ ГОТОВ К УСТАНОВКЕ. Только ручной include внутри http {}.
# admin.example.invalid, пути сертификатов и frontend root — преднамеренно
# нерабочие значения. Замена/проверка требуют отдельного решения оператора.
# API должен отдельно слушать ТОЛЬКО 127.0.0.1:8817, НЕ 0.0.0.0.
# Не включать на VPS, не заменять существующие 3x-ui/Telegram listeners.
#
# Считать IP клиента только из доверенного TCP peer, не из клиентского
# X-Forwarded-For. Если перед nginx CDN/LB — отдельный vetted real_ip design.
map "$request_method:$uri" $d1b_login_key {
    default "";
    "POST:/admin/subpage/api/session" $binary_remote_addr;
}
# Empty map key не расходует rate limit — GET /session не является login.
limit_req_zone $d1b_login_key zone=d1b_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=d1b_api:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=d1b_connection:10m;

server {
    # Compatible with legacy Nginx on GitHub runners; HTTP/2 only over TLS.
    listen 443 ssl http2;
    server_name admin.example.invalid;
    server_tokens off;

    # Неявные дефолтные vhosts, SNI/Host spoof и HTTP без TLS не допускаются.
    # До продакшена обязателен независимый default_server с reject/444.
    if ($host != "admin.example.invalid") { return 444; }
    if ($ssl_server_name != "admin.example.invalid") { return 444; }
    ssl_certificate /etc/d1b-admin/tls/fullchain.pem;
    ssl_certificate_key /etc/d1b-admin/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # Небольшой canary HSTS без includeSubDomains/preload; production policy
    # и охват соседних сервисов требуют отдельного security approval.
    add_header Strict-Transport-Security "max-age=300" always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'" always;

    root /srv/d1b-subscription-editor/dist;
    autoindex off;
    client_max_body_size 2m;
    client_body_timeout 10s;
    keepalive_timeout 15s;

    location = /admin.html {
        try_files /admin.html =404;
    }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location ^~ /admin/subpage/api/ {
        limit_req zone=d1b_api burst=20 nodelay;
        limit_req zone=d1b_login burst=4 nodelay;
        limit_req_status 429;
        limit_conn d1b_connection 5;

        # Данные login/сессий не должны попадать в обычный access log.
        # Запуск отдельного privacy-safe security audit — позже по approval.
        access_log off;
        proxy_pass http://127.0.0.1:8817;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host admin.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host admin.example.invalid;
        proxy_set_header X-Forwarded-For $remote_addr;
        # НЕ заменять клиентский Origin; backend проверяет точный HTTPS Origin
        # и Host сам до изменения сессий. Не доверять X-Forwarded-* от клиента.
        proxy_redirect off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    # Отдельный административный origin не публикует публичный D1a portal,
    # директории, index.html или никакие другие backend/web routes.
    location / {
        return 404;
    }
}
