{
  "schema": 1,
  "living_documents": [
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/LIVING_DOCS.md",
    "docs/ROADMAP.md",
    "docs/RELEASES.md",
    "docs/GIT_WORKFLOW.md",
    "docs/ADMIN_SETUP.md",
    "docs/BOT_SELF_UPDATE.md",
    "docs/VPS_RECOVERY.md",
    "docs/OFFSITE_BACKUP.md",
    "docs/SQLITE_MIGRATIONS.md",
    "docs/3XUI_OPENAPI_CONTRACT.md",
    "docs/UI_STYLE.md",
    "docs/V5_PRODUCTION_ACCEPTANCE.md",
    "docs/CLIENT_SETUP.md"
  ],
  "rules": [
    {
      "id": "release-version",
      "mode": "require_all",
      "triggers": [
        "version.py"
      ],
      "documents": [
        "README.md",
        "CHANGELOG.md",
        "docs/ADMIN_SETUP.md",
        "docs/SQLITE_MIGRATIONS.md"
      ]
    },
    {
      "id": "operator-setup",
      "mode": "review",
      "triggers": [
        ".env.example",
        "Dockerfile",
        "docker-compose.yml",
        "deploy/**",
        "scripts/install-*.sh",
        "scripts/setup-*.sh",
        "scripts/onboard-*.py",
        "scripts/onboard-*.sh",
        "scripts/prepare-*.sh",
        "scripts/bootstrap-bot-from-backup.sh",
        "scripts/fetch-offsite-backup.py"
      ],
      "documents": [
        "docs/ADMIN_SETUP.md"
      ],
      "waiver": "Admin Setup: изменений не требуется"
    },
    {
      "id": "release-process",
      "mode": "review",
      "triggers": [
        ".github/workflows/release.yml",
        ".github/workflows/pr-conventions.yml",
        "scripts/deploy-release.sh",
        "scripts/render-release-notes.py"
      ],
      "documents": [
        "docs/RELEASES.md",
        "docs/GIT_WORKFLOW.md"
      ],
      "waiver": "Living Docs: release-process — изменений не требуется"
    },
    {
      "id": "ci-governance",
      "mode": "review",
      "triggers": [
        ".github/workflows/tests.yml",
        ".github/workflows/repository-state-audit.yml",
        "scripts/check-living-docs.py",
        "scripts/check-repository-state.py",
        "docs/live-docs.json",
        ".github/workflows/roadmap-github-audit.yml",
        "scripts/check-documentation-semantics.py",
        "scripts/check-roadmap-github.py"
      ],
      "documents": [
        "docs/LIVING_DOCS.md",
        "docs/GIT_WORKFLOW.md"
      ],
      "waiver": "Living Docs: ci-governance — изменений не требуется"
    },
    {
      "id": "database-schema",
      "mode": "review",
      "triggers": [
        "db_migrations.py",
        "database.py"
      ],
      "documents": [
        "docs/SQLITE_MIGRATIONS.md"
      ],
      "waiver": "Living Docs: database-schema — изменений не требуется"
    },
    {
      "id": "security-reporting",
      "mode": "review",
      "triggers": [
        "SECURITY.md",
        ".github/VULNERABILITY_REPORT.yml",
        ".github/ISSUE_TEMPLATE/**"
      ],
      "documents": [
        "SECURITY.md"
      ],
      "waiver": "Living Docs: security-reporting — изменений не требуется"
    },
    {
      "id": "3xui-openapi-contract",
      "mode": "require_all",
      "triggers": [
        "contracts/3xui/contract.json",
        "contracts/3xui/**/openapi.json"
      ],
      "documents": [
        "docs/3XUI_OPENAPI_CONTRACT.md"
      ]
    },
    {
      "id": "3xui-client-api",
      "mode": "review",
      "triggers": [
        "xui.py",
        "version_api.py"
      ],
      "documents": [
        "docs/3XUI_OPENAPI_CONTRACT.md"
      ],
      "waiver": "Living Docs: 3xui-client-api — изменений не требуется"
    },
    {
      "id": "v5-client-acceptance",
      "mode": "review",
      "triggers": [
        "client_access.py",
        "client_flags.py",
        "commerce.py",
        "customer_service.py",
        "customer_provider_xui.py",
        "db_migrations.py"
      ],
      "documents": [
        "docs/V5_PRODUCTION_ACCEPTANCE.md",
        "docs/CLIENT_SETUP.md"
      ],
      "waiver": "Living Docs: v5-client-acceptance — изменений не требуется"
    },
    {
      "id": "roadmap-structure",
      "mode": "review",
      "triggers": [
        "docs/ROADMAP.md",
        "docs/roadmap/**",
        "docs/audits/roadmap-history/**",
        "scripts/check-roadmap-structure.py",
        "docs/roadmap/concept-registry.json",
        "scripts/check-roadmap-governance.py"
      ],
      "documents": [
        "docs/GIT_WORKFLOW.md",
        "docs/LIVING_DOCS.md"
      ],
      "waiver": "Living Docs: roadmap-structure — изменений не требуется"
    },
    {
      "id": "audit-documentation",
      "mode": "review",
      "triggers": [
        "docs/audits/**",
        "docs/roadmap/concepts/**",
        "docs/audits/AUDIT_TEMPLATE.md",
        "docs/roadmap/concept-registry.json",
        "tests/test_roadmap_final_governance.py"
      ],
      "documents": [
        "docs/ROADMAP.md",
        "docs/LIVING_DOCS.md"
      ],
      "waiver": "Living Docs: audit-documentation — изменений не требуется"
    },
    {
      "id": "agent-mode",
      "mode": "review",
      "triggers": [
        "AGENTS.md",
        "scripts/check-project-language.py",
        "scripts/check_pr_checklist.py"
      ],
      "documents": [
        "docs/GIT_WORKFLOW.md",
        "docs/LIVING_DOCS.md"
      ],
      "waiver": "Living Docs: agent-mode — изменений не требуется"
    },
    {
      "id": "telegram-ui-language",
      "mode": "review",
      "triggers": [
        "advanced_users.py",
        "admin_ui.py",
        "admin_navigation.py",
        "flow_edit_routes.py",
        "client_access.py"
      ],
      "documents": [
        "docs/UI_STYLE.md"
      ],
      "waiver": "Living Docs: telegram-ui-language — изменений не требуется"
    }
  ],
  "repository_state": {
    "visibility": "public",
    "branch_ruleset": {
      "name": "Protect main release path",
      "target": "branch",
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "enforcement": "active",
      "required_rules": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_status_checks",
        "required_linear_history"
      ],
      "allowed_merge_methods": [
        "squash"
      ],
      "required_status_checks": [
        "test",
        "title"
      ],
      "strict_status_checks": true,
      "no_bypass": true
    },
    "tag_ruleset": {
      "name": "Protect release tags",
      "target": "tag",
      "include": [
        "refs/tags/v*"
      ],
      "enforcement": "active",
      "required_rules": [
        "deletion",
        "non_fast_forward",
        "update"
      ],
      "forbidden_rules": [
        "creation"
      ],
      "no_bypass": true
    }
  }
}
